<UserControl x:Class="DashAppManagerWPF.ConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="712" d:DesignWidth="974">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="577*"/>
            <ColumnDefinition Width="397*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Section - Profile Grid -->
        <Border Grid.Column="0" Background="#0e121a" CornerRadius="20,0,0,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="30">

                    <!-- Profiles Title -->
                    <TextBlock Text="Profiles"
                              Foreground="White"
                              FontSize="32"
                              FontWeight="Bold"
                              Margin="0,0,0,30"/>

                    <!-- Profile Cards Grid -->
                    <UniformGrid x:Name="ProfileGrid" Columns="2" Rows="3" Margin="0,10,0,0">
                        <!-- Dynamic profile cards will be generated here -->
                    </UniformGrid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Section - Profile Form -->
        <Border Grid.Column="1" Background="#141720" CornerRadius="0,20,20,0">
            <Grid x:Name="ConfigSubGrid">

                <!-- Profile Creation/Editing Form -->
                <ScrollViewer x:Name="ProfileFormScrollViewer" VerticalScrollBarVisibility="Auto"    
                             HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">        
                    <StackPanel Margin="30" x:Name="ProfileFormPanel">

                        <!-- Form Title -->
                        <TextBlock x:Name="FormTitle" Text="Create New Profile"
                                  Foreground="White" FontSize="24" FontWeight="Bold"
                                  Margin="0,0,0,30"/>

                        <!-- Profile Name -->
                        <TextBlock Text="Profile Name" Foreground="White" FontSize="14"
                                  FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Border Background="#1e2329" CornerRadius="8" Margin="0,0,0,20">
                            <TextBox x:Name="ProfileNameTextBox" Background="Transparent"
                                    Foreground="White" BorderThickness="0" Padding="12"
                                    FontSize="14" Text="Enter profile name..."
                                    GotFocus="ProfileNameTextBox_GotFocus"
                                    LostFocus="ProfileNameTextBox_LostFocus"/>
                        </Border>

                        <!-- Profile Description -->
                        <TextBlock Text="Description" Foreground="White" FontSize="14"
                                  FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Border Background="#1e2329" CornerRadius="8" Margin="0,0,0,20">
                            <TextBox x:Name="ProfileDescriptionTextBox" Background="Transparent"
                                    Foreground="White" BorderThickness="0" Padding="12"
                                    FontSize="14" Text="Enter role description..."
                                    TextWrapping="Wrap" AcceptsReturn="True" Height="60"
                                    GotFocus="ProfileDescriptionTextBox_GotFocus"
                                    LostFocus="ProfileDescriptionTextBox_LostFocus"/>
                        </Border>

                        <!-- Profile Icon -->
                        <TextBlock Text="Profile Icon" Foreground="White" FontSize="14"
                                  FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border x:Name="IconOption1" Width="40" Height="40" CornerRadius="8"   
                                   Background="#2D3748" Margin="0,0,10,0" Padding="8"
                                   MouseLeftButtonUp="IconOption_Click" Tag="assets/icons/3dbc93.png" Cursor="Hand">
                                <Image Source="assets/icons/3dbc93.png" Stretch="Uniform"/>
                            </Border>
                            <Border x:Name="IconOption2" Width="40" Height="40" CornerRadius="8"   
                                   Background="#2D3748" Margin="0,0,10,0" Padding="8"
                                   MouseLeftButtonUp="IconOption_Click" Tag="assets/icons/58b0e0.png" Cursor="Hand">
                                <Image Source="assets/icons/58b0e0.png" Stretch="Uniform"/>
                            </Border>
                            <Border x:Name="IconOption3" Width="40" Height="40" CornerRadius="8"   
                                   Background="#2D3748" Margin="0,0,10,0" Padding="8"
                                   MouseLeftButtonUp="IconOption_Click" Tag="assets/icons/485a69.png" Cursor="Hand">
                                <Image Source="assets/icons/485a69.png" Stretch="Uniform"/>
                            </Border>
                            <Border x:Name="IconOption4" Width="40" Height="40" CornerRadius="8"   
                                   Background="#2D3748" Margin="0,0,10,0" Padding="8"
                                   MouseLeftButtonUp="IconOption_Click" Tag="assets/icons/a9cf54.png" Cursor="Hand">
                                <Image Source="assets/icons/a9cf54.png" Stretch="Uniform"/>
                            </Border>
                            <Border x:Name="IconOption5" Width="40" Height="40" CornerRadius="8"   
                                   Background="#2D3748" Margin="0,0,10,0" Padding="8"
                                   MouseLeftButtonUp="IconOption_Click" Tag="assets/icons/e9573e.png" Cursor="Hand">
                                <Image Source="assets/icons/e9573e.png" Stretch="Uniform"/>
                            </Border>
                            <Border x:Name="IconOption6" Width="40" Height="40" CornerRadius="8"   
                                   Background="#2D3748" Margin="0,0,10,0" Padding="8"
                                   MouseLeftButtonUp="IconOption_Click" Tag="assets/icons/ffc200.png" Cursor="Hand">
                                <Image Source="assets/icons/ffc200.png" Stretch="Uniform"/>
                            </Border>
                        </StackPanel>

                        <!-- Time Slot -->
                        <TextBlock Text="Time Slot" Foreground="White" FontSize="14"
                                  FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Start Time -->
                            <Border Grid.Column="0" Background="#1e2329" CornerRadius="8">
                                <ComboBox x:Name="StartTimeComboBox" Background="Transparent"        
                                         Foreground="Black" BorderThickness="0" Padding="12"
                                         FontSize="14">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </Border>

                            <TextBlock Grid.Column="1" Text=" - " Foreground="White" FontSize="16"   
                                      VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0"/>
                            
                            <!-- End Time -->
                            <Border Grid.Column="2" Background="#1e2329" CornerRadius="8">
                                <ComboBox x:Name="EndTimeComboBox" Background="Transparent"
                                         Foreground="Black" BorderThickness="0" Padding="12"
                                         FontSize="14">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </Border>
                        </Grid>

                        <!-- Tasks -->
                        <TextBlock Text="Tasks" Foreground="White" FontSize="14"
                                  FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <!-- Add Task Input -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#1e2329" CornerRadius="8,0,0,8">     
                                <TextBox x:Name="NewTaskTextBox" Background="Transparent" 
                                        Foreground="White" BorderThickness="0" Padding="12"
                                        FontSize="14" Text="Enter new task..."
                                        GotFocus="NewTaskTextBox_GotFocus"
                                        LostFocus="NewTaskTextBox_LostFocus"
                                        KeyDown="NewTaskTextBox_KeyDown"/>
                            </Border>

                            <Button Grid.Column="1" Content="Add" Background="#4a9eff"
                                   Foreground="White" BorderThickness="0" Padding="15,12"
                                   FontSize="12" FontWeight="SemiBold"
                                   Click="AddTask_Click"/>
                        </Grid>

                        <!-- Task List -->
                        <Border Background="#1e2329" CornerRadius="8" MinHeight="120" Margin="0,0,0,30">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">        
                                <ItemsControl x:Name="TasksItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#252b33" Margin="8,4" CornerRadius="6" Padding="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding}"      
                                                              Foreground="White" FontSize="13"       
                                                              VerticalAlignment="Center"/>

                                                    <Button Grid.Column="1" Content="×"
                                                           Background="Transparent" Foreground="#ff6b6b"
                                                           BorderThickness="0" FontSize="16" FontWeight="Bold"
                                                           Width="20" Height="20"
                                                           Click="RemoveTask_Click" Tag="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Delete Button (only visible when editing) -->
                            <Button x:Name="DeleteProfileButton" Grid.Column="0" Content="Delete Profile"
                                   Background="#ff4757" Foreground="White" BorderThickness="0"       
                                   Padding="25,15" FontSize="14" FontWeight="SemiBold"
                                   Click="DeleteProfile_Click" Visibility="Collapsed" MinWidth="140"/>

                            <!-- Cancel Button -->
                            <Button Grid.Column="1" Content="Cancel" Background="#6c757d"
                                   Foreground="White" BorderThickness="0" Padding="25,15"
                                   FontSize="14" FontWeight="SemiBold" Margin="15,0"
                                   Click="CancelProfile_Click" MinWidth="100"/>

                            <!-- Save Button -->
                            <Button x:Name="SaveProfileButton" Grid.Column="2" Content="Create Profile"
                                   Background="#28a745" Foreground="White" BorderThickness="0"       
                                   Padding="25,15" FontSize="14" FontWeight="SemiBold"
                                   Click="SaveProfile_Click" MinWidth="150"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

                <!-- Welcome Message (Default State) -->
                <StackPanel x:Name="WelcomePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Profile Manager" Foreground="White" FontSize="28"
                              FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>     
                    <TextBlock Text="Select a profile to edit or create a new one"
                              Foreground="Gray" FontSize="16" HorizontalAlignment="Center"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>
