<UserControl x:Class="DashAppManagerWPF.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DashAppManagerWPF"
             mc:Ignorable="d" 
             d:DesignHeight="712" d:DesignWidth="974">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="577*"/>
            <ColumnDefinition Width="397*"/>
        </Grid.ColumnDefinitions>

        <local:DashboardView Grid.Column="0" />

        <!-- Right Section Grid -->
        <Border Grid.Column="1" Background="#141720" CornerRadius="0,20,20,0">
            <!-- Right section content -->
        </Border>
    </Grid>
</UserControl>
