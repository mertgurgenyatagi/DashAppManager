<UserControl x:Class="DashAppManagerWPF.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DashAppManagerWPF"
             mc:Ignorable="d" 
             d:DesignHeight="712" d:DesignWidth="974">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="577*"/>
            <ColumnDefinition Width="397*"/>
        </Grid.ColumnDefinitions>
        
        <!-- HIGHEST PRIORITY: Transparent drag zone overlay in top 70px -->
        <Rectangle x:Name="DragZoneOverlay" 
                   Grid.ColumnSpan="2"
                   Height="70" 
                   VerticalAlignment="Top"
                   Fill="Transparent" 
                   Panel.ZIndex="9999"
                   MouseLeftButtonDown="DragZoneOverlay_MouseLeftButtonDown"
                   IsHitTestVisible="True"/>

        <local:DashboardView Grid.Column="0" />

        <!-- Right Section Grid -->
        <Border Grid.Column="1" Background="#141720" CornerRadius="0,20,20,0">
            <!-- Transition Container for Right Section Content -->
            <Grid x:Name="RightSectionTransitionContainer">
                <!-- Content Host 1 -->
                <ScrollViewer x:Name="RightContentHost1" 
                            VerticalScrollBarVisibility="Auto" 
                            HorizontalScrollBarVisibility="Disabled"
                            Opacity="1">
                    <StackPanel x:Name="RightSectionContent" Margin="30">
                        
                        <!-- Time Display -->
                        <Border Background="#1e2329" CornerRadius="15" Padding="20" Margin="0,0,0,25">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="CurrentTimeText" Text="14:30" 
                                         Foreground="White" FontSize="36" FontWeight="Bold" 
                                         HorizontalAlignment="Center"/>
                                <TextBlock x:Name="CurrentDateText" Text="Thursday, September 5" 
                                         Foreground="Gray" FontSize="14" 
                                         HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Profile Section (shown when current role is clicked) -->
                        <StackPanel x:Name="ProfileSection" Visibility="Collapsed" Margin="0,0,0,25">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Circular Profile Image -->
                                <Ellipse Grid.Column="0" Width="50" Height="50" Fill="#FF6347" 
                                        HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                
                                <!-- Profile Text -->
                                <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Project Manager" Foreground="White" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="Active Profile" Foreground="Gray" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Tasks Section (shown when current role is clicked) -->
                        <StackPanel x:Name="TasksSection" Visibility="Collapsed">
                            <TextBlock Text="Today's Tasks" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                            
                            <!-- Task 1 -->
                            <Border Background="#1e2329" CornerRadius="10" Padding="15" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#32CD32" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Review project requirements" Foreground="White" FontWeight="Medium"/>
                                        <TextBlock Text="Due: 15:30" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="High" Foreground="#FF6347" FontSize="10" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Task 2 -->
                            <Border Background="#1e2329" CornerRadius="10" Padding="15" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#FFD700" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Team standup meeting" Foreground="White" FontWeight="Medium"/>
                                        <TextBlock Text="Due: 16:00" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="Medium" Foreground="#FFD700" FontSize="10" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Task 3 -->
                            <Border Background="#1e2329" CornerRadius="10" Padding="15" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#4682B4" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Update project documentation" Foreground="White" FontWeight="Medium"/>
                                        <TextBlock Text="Due: 17:30" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="Low" Foreground="#4682B4" FontSize="10" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Task 4 -->
                            <Border Background="#1e2329" CornerRadius="10" Padding="15" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#9370DB" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Client presentation prep" Foreground="White" FontWeight="Medium"/>
                                        <TextBlock Text="Due: Tomorrow 10:00" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="High" Foreground="#FF6347" FontSize="10" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Task 5 -->
                            <Border Background="#1e2329" CornerRadius="10" Padding="15" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#32CD32" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Code review session" Foreground="White" FontWeight="Medium"/>
                                        <TextBlock Text="Due: Tomorrow 14:00" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="Medium" Foreground="#FFD700" FontSize="10" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
                
                <!-- Content Host 2 (for transitions) -->
                <ScrollViewer x:Name="RightContentHost2" 
                            VerticalScrollBarVisibility="Auto" 
                            HorizontalScrollBarVisibility="Disabled"
                            Opacity="0">
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
