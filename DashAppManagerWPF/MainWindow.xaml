        <Window.Resources>
                <QuadraticEase x:Key="EaseOut" EasingMode="EaseOut" />
        </Window.Resources>
        <Grid>
                <Canvas>
                                        <!-- All rectangles: round all corners, offset 20px from window edge -->
                                                                                <Border Canvas.Left="0" Canvas.Top="0" Width="83" Height="712" CornerRadius="20" Background="#141720">
                                                                                        <Canvas x:Name="NavCanvas" Width="83" Height="712">
