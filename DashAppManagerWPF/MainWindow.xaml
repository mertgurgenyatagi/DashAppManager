                                                                                        </Canvas>
                                                                                </Border>
                                                                                                                                                                                                                                                <!-- Middle window: background color -->
                                                                                                                                                                                                                                                <Border Canvas.Left="83" Canvas.Top="0" Width="577" Height="712" CornerRadius="20" Background="#0e121a" />
                                                                                                                                                                                                                                                <!-- Middle window: transparent overlay for dots and rounded corners -->
                                                                                                                                                                                                                                                <Border Canvas.Left="83" Canvas.Top="0" Width="577" Height="712" CornerRadius="20" Background="Transparent">
                                                                                                                                                                                                                                                    <Canvas x:Name="DotsCanvas" Width="577" Height="712">
                                                                                                                                                                                                                                                        <Canvas.RenderTransform>
                                                                                                                                                                                                                                                            <TranslateTransform X="5" Y="5" />
                                                                                                                                                                                                                                                        </Canvas.RenderTransform>
                                                                                                                                                                                                                                                    </Canvas>
                                                                                                                                                                                                                                                </Border>
                                                                                                                                                                <!-- Page Content Host -->
                                                                                                                                                                                                                                                                                                                                <!-- Right section backdrop - behind page content -->
                                                                                <Border Canvas.Left="660" Canvas.Top="0" Width="397" Height="712" CornerRadius="20" Background="#141720" Panel.ZIndex="-1" />
                                                                                <!-- Overlapping Page Content Hosts -->
                                                                                <ContentControl x:Name="PageContentHost1" Canvas.Left="83" Canvas.Top="0" Width="974" Height="712" Panel.ZIndex="1"/>
                                                                                <ContentControl x:Name="PageContentHost2" Canvas.Left="83" Canvas.Top="0" Width="974" Height="712" Panel.ZIndex="2"/>
                                        <!-- Logo padded 20px from top and left -->
                                                                                <Button x:Name="LogoButton" Width="40" Height="40" Canvas.Left="20" Canvas.Top="20" Background="Transparent" BorderThickness="0" Focusable="False">
                                                                                                                                        <Button.Template>
                                                                                                                                                <ControlTemplate TargetType="Button">
                                                                                                                                                        <Grid>
                                                                                                                                                                                                                                                                                <Image x:Name="LogoImage" Source="pack://application:,,,/assets/images/dashapp_logo.png" Width="40" Height="40" RenderTransformOrigin="0.5,0.5">
                                                                                                                                                                                                                                                                                        <Image.RenderTransform>
                                                                                                                                                                                                                                                                                                <ScaleTransform x:Name="LogoPulse" ScaleX="1" ScaleY="1" />
                                                                                                                                                                                                                                                                                        </Image.RenderTransform>
                                                                                                                                                                                                                                                                                </Image>
                                                                                                                                                        </Grid>
                                                                                                                                                        <ControlTemplate.Triggers>
                                                                                                                                                                                                                                                                                <EventTrigger RoutedEvent="Button.Click">
                                                                                                                                                                                                                                                                                        <BeginStoryboard>
                                                                                                                                                                                                                                                                                                <Storyboard>
                                                                                                                                                                                                                                                                                                            <DoubleAnimation Storyboard.TargetName="LogoPulse" Storyboard.TargetProperty="ScaleX" To="1.25" Duration="0:0:0.13" AutoReverse="True" FillBehavior="Stop" />
                                                                                                                                                                                                                                                                                                            <DoubleAnimation Storyboard.TargetName="LogoPulse" Storyboard.TargetProperty="ScaleY" To="1.25" Duration="0:0:0.13" AutoReverse="True" FillBehavior="Stop" />
                                                                                                                                                                                                                                                                                                </Storyboard>
                                                                                                                                                                                                                                                                                        </BeginStoryboard>
                                                                                                                                                                                                                                                                                </EventTrigger>
                                                                                                                                                        </ControlTemplate.Triggers>
                                                                                                                                                </ControlTemplate>
                                                                                                                                        </Button.Template>
                                                                                </Button>
                
                <!-- App-wide Canvas for absolute positioning across the entire application -->
                <Canvas x:Name="AppCanva" IsHitTestVisible="False" Width="1057" Height="752" Background="Transparent"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        RenderOptions.EdgeMode="Aliased"
                        UseLayoutRounding="True">
                </Canvas>
                </Canvas>
        </Grid>
</Window>
