<Window x:Class="DashAppManagerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DashAppManagerWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="752" Width="1057" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent">
                                <Canvas>
                                        <!-- All rectangles: round all corners, offset 20px from window edge -->
                                        <Border Canvas.Left="0" Canvas.Top="0" Width="83" Height="712" CornerRadius="20" Background="#2e2e47" />
                                        <Border Canvas.Left="83" Canvas.Top="0" Width="577" Height="712" CornerRadius="20" Background="#2a2b42" />
                                        <Border Canvas.Left="660" Canvas.Top="0" Width="397" Height="712" CornerRadius="20" Background="#2e2e47" />
                                        <!-- Logo padded 20px from top and left -->
                                        <Image Source="pack://application:,,,/assets/images/dashapp_logo.png" Width="40" Height="40" Canvas.Left="20" Canvas.Top="20" />
                                </Canvas>
</Window>
