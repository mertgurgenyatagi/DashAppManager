                                                                                                                                                                                </VisualStateManager.VisualStateGroups>
                                                                                                                                                                        </Grid>
                                                                                                                                                                        <ControlTemplate.Triggers>
                                                                                                                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                                                                                                                        <Setter TargetName="DashboardIcon" Property="Source" Value="pack://application:,,,/assets/icons/dashboard_blue.png" />
