<UserControl x:Class="DashAppManagerWPF.UserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             IsHitTestVisible="False">
    <!-- Only content, no background or border at root -->
    <Grid IsHitTestVisible="True" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="577*"/>
                <ColumnDefinition Width="397*"/>
            </Grid.ColumnDefinitions>

            <!-- Middle Section Grid -->
            <Border Grid.Column="0" Background="#0e121a" CornerRadius="20,20,20,20" Margin="0,0,-1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40">

                        <!-- My Profile Title -->
                        <TextBlock Text="My Profile" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

                        <!-- Profile Card -->
                        <Border Background="#141720" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Profile Picture -->
                                <Ellipse Width="80" Height="80" Fill="Gray" Margin="0,0,20,0"/>

                                <!-- User Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="6:45pm, Nigerian Time" Foreground="LightGray" FontSize="12"/>
                                    <TextBlock Text="Temitope Aiyegbusi" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Ellipse Width="8" Height="8" Fill="Orange" VerticalAlignment="Center"/>
                                        <TextBlock Text="Marketing Dpt" Foreground="LightGray" FontSize="14" Margin="5,0,0,0"/>
                                        <TextBlock Text="|" Foreground="LightGray" FontSize="14" Margin="10,0,10,0"/>
                                        <TextBlock Text="Product Designer" Foreground="LightGray" FontSize="14"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Edit Image Button -->
                                <Button Grid.Column="2" Content="Edit Image" Style="{StaticResource ModernButtonStyle}" VerticalAlignment="Top"/>
                            </Grid>
                        </Border>

                        <!-- Line Manager and Department -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#141720" Padding="15" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Line Manager" Foreground="LightGray" FontSize="12"/>
                                    <TextBlock Text="Olawale Oguntayo" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#141720" Padding="15" Margin="10,0,0,0">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Department" Foreground="LightGray" FontSize="12"/>
                                        <TextBlock Text="Product Design" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text=">" Foreground="LightGray" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Details List -->
                        <StackPanel Margin="0,30,0,0">
                            <Border BorderBrush="#3D3D3D" BorderThickness="0,0,0,1" Padding="0,0,0,15">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Rectangle Width="24" Height="24" Fill="Gray" RadiusX="5" RadiusY="5"/>
                                        <TextBlock Text="Personal Details" Foreground="White" FontSize="16" Margin="15,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text=">" Foreground="LightGray" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border BorderBrush="#3D3D3D" BorderThickness="0,0,0,1" Padding="0,15,0,15" Margin="0,10,0,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Rectangle Width="24" Height="24" Fill="Gray" RadiusX="5" RadiusY="5"/>
                                        <TextBlock Text="Contact Information" Foreground="White" FontSize="16" Margin="15,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text=">" Foreground="LightGray" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border BorderBrush="#3D3D3D" BorderThickness="0,0,0,1" Padding="0,15,0,15" Margin="0,10,0,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Rectangle Width="24" Height="24" Fill="Gray" RadiusX="5" RadiusY="5"/>
                                        <TextBlock Text="Work Details" Foreground="White" FontSize="16" Margin="15,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text=">" Foreground="LightGray" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border BorderBrush="#3D3D3D" BorderThickness="0,0,0,1" Padding="0,15,0,15" Margin="0,10,0,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Rectangle Width="24" Height="24" Fill="Gray" RadiusX="5" RadiusY="5"/>
                                        <TextBlock Text="Work Documents" Foreground="White" FontSize="16" Margin="15,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text=">" Foreground="LightGray" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border BorderBrush="#3D3D3D" BorderThickness="0,0,0,1" Padding="0,15,0,15" Margin="0,10,0,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Rectangle Width="24" Height="24" Fill="Gray" RadiusX="5" RadiusY="5"/>
                                        <TextBlock Text="Account Settings" Foreground="White" FontSize="16" Margin="15,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text=">" Foreground="LightGray" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Section Grid -->
            <Border Grid.Column="1" Background="#141720" CornerRadius="20,20,20,20" Margin="-1,0,0,0">
                <StackPanel Margin="20">
                    <TextBlock Text="My Activity" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <!-- Activity content will go here -->
                </StackPanel>
            </Border>
    </Grid>
</UserControl>
