<UserControl x:Class="DashAppManagerWPF.NotificationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DashAppManagerWPF"
             mc:Ignorable="d" 
             d:DesignHeight="712" d:DesignWidth="974">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="577*"/>
            <ColumnDefinition Width="397*"/>
        </Grid.ColumnDefinitions>

        <!-- Middle Section -->
        <Grid x:Name="NotificationsMiddleGrid" Grid.Column="0" Background="#0e121a" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Notifications" 
                               Foreground="White" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               FontFamily="pack://application:,,,/assets/fonts/#Inter"/>
                    <TextBlock Text="Stay updated with your latest activities and messages" 
                               Foreground="#888" 
                               FontSize="14" 
                               FontFamily="pack://application:,,,/assets/fonts/#Inter"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <Grid Height="80">
                        <Button Style="{StaticResource MarkAllAsReadButton}" VerticalAlignment="Center" Click="MarkAllAsRead_Click">Mark All as Read</Button>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Search and Filters -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search Bar -->
                <TextBox Grid.Row="0" Text="Search notifications..." Style="{StaticResource SearchTextBox}" Margin="0,0,0,10"/>

                <!-- Filter Buttons -->
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Style="{StaticResource TypeButtonWithIcon}" Margin="0,0,10,0" Click="Type_Click">Type</Button>
                    <Button Style="{StaticResource SortButtonWithIcon}" Margin="0,0,10,0" Click="Sort_Click">Sort</Button>
                </StackPanel>
            </Grid>

            <!-- Notifications List -->
            <Border Grid.Row="2" Background="#0e121a" BorderBrush="#3a3f4a" BorderThickness="1" CornerRadius="8">
                <ListView x:Name="NotificationsListView" Background="Transparent" BorderThickness="0">
                </ListView>
            </Border>
        </Grid>

        <!-- Right Section Placeholder -->
        <Border Grid.Column="1" Background="#141720" CornerRadius="20">
            <Grid x:Name="NotificationsRightGrid">
                <TextBlock Text="Right Panel" 
                           FontFamily="pack://application:,,,/assets/fonts/#Inter"
                           FontSize="16" 
                           Foreground="#888" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
