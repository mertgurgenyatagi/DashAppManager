<UserControl x:Class="DashAppManagerWPF.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DashAppManagerWPF"
    mc:Ignorable="d"
    d:DesignHeight="712" d:DesignWidth="974">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="577*"/>
            <ColumnDefinition Width="397*"/>
        </Grid.ColumnDefinitions>

        <!-- Middle Section Grid -->
        <local:CalendarView Grid.Column="0" />

        <!-- Right Section Grid -->
        <Border Grid.Column="1" Background="#141720" CornerRadius="20,20,20,20" Margin="-1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="CalendarRightPanel" Margin="30">
                    <!-- Default content -->
                    <StackPanel x:Name="DefaultContent" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📅" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Select a day or create a new project" 
                                 Foreground="Gray" 
                                 FontSize="16" 
                                 HorizontalAlignment="Center"
                                 TextAlignment="Center"
                                 TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Project Creation Form -->
                    <StackPanel x:Name="ProjectCreationForm" Visibility="Collapsed">
                        <TextBlock Text="Create New Project" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                        
                        <TextBlock Text="Project Name" Foreground="LightGray" FontSize="12" Margin="0,0,0,5"/>
                        <Border Background="#1e2329" CornerRadius="8" BorderBrush="#3a3f4a" BorderThickness="1" Margin="0,0,0,15">
                            <TextBox x:Name="ProjectNameTextBox" Background="Transparent" Foreground="White" BorderThickness="0" Padding="12,10" FontSize="14"/>
                        </Border>
                        
                        <TextBlock Text="Start Date" Foreground="LightGray" FontSize="12" Margin="0,0,0,5"/>
                        <Border Background="#1e2329" CornerRadius="8" BorderBrush="#3a3f4a" BorderThickness="1" Margin="0,0,0,15">
                            <DatePicker x:Name="ProjectStartDatePicker" Background="Transparent" Foreground="White" BorderThickness="0" Padding="12,10" FontSize="14">
                                <DatePicker.Resources>
                                    <Style TargetType="DatePickerTextBox">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="FontSize" Value="14"/>
                                    </Style>
                                </DatePicker.Resources>
                            </DatePicker>
                        </Border>
                        
                        <TextBlock Text="End Date" Foreground="LightGray" FontSize="12" Margin="0,0,0,5"/>
                        <Border Background="#1e2329" CornerRadius="8" BorderBrush="#3a3f4a" BorderThickness="1" Margin="0,0,0,15">
                            <DatePicker x:Name="ProjectEndDatePicker" Background="Transparent" Foreground="White" BorderThickness="0" Padding="12,10" FontSize="14">
                                <DatePicker.Resources>
                                    <Style TargetType="DatePickerTextBox">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="FontSize" Value="14"/>
                                    </Style>
                                </DatePicker.Resources>
                            </DatePicker>
                        </Border>
                        
                        <TextBlock Text="Description" Foreground="LightGray" FontSize="12" Margin="0,0,0,5"/>
                        <Border Background="#1e2329" CornerRadius="8" BorderBrush="#3a3f4a" BorderThickness="1" Margin="0,0,0,20">
                            <TextBox x:Name="ProjectDescriptionTextBox" Background="Transparent" Foreground="White" BorderThickness="0" Padding="12,10" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" Height="80"/>
                        </Border>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Background="#3a3f4a" CornerRadius="6" Margin="0,0,10,0">
                                <Button x:Name="CancelProjectButton" Content="Cancel" Background="Transparent" Foreground="White" BorderBrush="Transparent" BorderThickness="0" Padding="20,10" Click="CancelProjectButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#4a4f5a"/>
                                                    <Setter Property="Foreground" Value="#ffffff"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Border>
                            <Border Background="#32CD32" CornerRadius="6">
                                <Button x:Name="CreateProjectButton" Content="Create Project" Background="Transparent" Foreground="White" BorderBrush="Transparent" BorderThickness="0" Padding="20,10" Click="CreateProjectButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#28a745"/>
                                                    <Setter Property="Foreground" Value="#ffffff"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Project Details -->
                    <StackPanel x:Name="ProjectDetails" Visibility="Collapsed">
                        <TextBlock x:Name="ProjectDetailsTitle" Text="Project Details" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                        
                        <Border Background="#1e2329" CornerRadius="10" Padding="20" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Project Name" Foreground="LightGray" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock x:Name="ProjectDetailsName" Text="Sample Project" Foreground="White" FontSize="16" FontWeight="Medium" Margin="0,0,0,15"/>
                                
                                <TextBlock Text="Duration" Foreground="LightGray" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock x:Name="ProjectDetailsDuration" Text="Sep 6, 2025 - Sep 10, 2025" Foreground="White" FontSize="14" Margin="0,0,0,15"/>
                                
                                <TextBlock Text="Description" Foreground="LightGray" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock x:Name="ProjectDetailsDescription" Text="Project description will appear here" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Background="#3a3f4a" CornerRadius="6" HorizontalAlignment="Left">
                            <Button x:Name="CloseDetailsButton" Content="Close" Background="Transparent" Foreground="White" BorderBrush="Transparent" BorderThickness="0" Padding="20,10" Click="CloseDetailsButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#4a4f5a"/>
                                                <Setter Property="Foreground" Value="#ffffff"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
