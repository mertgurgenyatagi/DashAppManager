<UserControl x:Class="DashAppManagerWPF.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DashAppManagerWPF"
    mc:Ignorable="d"
    d:DesignHeight="712" d:DesignWidth="974">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="577*"/>
            <ColumnDefinition Width="397*"/>
        </Grid.ColumnDefinitions>

        <!-- Middle Section Grid -->
        <local:CalendarView Grid.Column="0" />

        <!-- Right Section Grid -->
        <Border BorderBrush="Blue" BorderThickness="2" Grid.Column="1">
            <Grid x:Name="CalendarSubGrid">
                <!-- Content for the right section goes here -->
            </Grid>
        </Border>
    </Grid>
</UserControl>
