<UserControl x:Class="SPMWPF.UserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             IsHitTestVisible="False">
    <!-- Only content, no background or border at root -->
    <Grid IsHitTestVisible="True" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="577*"/>
            <ColumnDefinition Width="397*"/>
        </Grid.ColumnDefinitions>

        <!-- Middle Section Grid -->
        <Border Grid.Column="0" Background="#0e121a" CornerRadius="20,20,20,20" Margin="0,0,-1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40">

                    <!-- Current Profile Title -->
                    <TextBlock Text="Current Profile" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

                    <!-- Profile Card - Enlarged -->
                    <Border x:Name="ProfileCard" Background="#141720" Padding="40" Height="300">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Profile Icon with Shadow Effect -->
                            <Border x:Name="ProfileIconBorder" Width="120" Height="120" CornerRadius="60" 
                                    HorizontalAlignment="Center" Background="#2D3748" Padding="20">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" BlurRadius="8" Opacity="0.3"/>
                                </Border.Effect>
                                <Image x:Name="ProfileIcon" Source="assets/icons/3dbc93.png" Stretch="Uniform"/>
                            </Border>
                            
                            <!-- Profile Name -->
                            <TextBlock x:Name="ProfileName" Text="Early Morning Focus" Foreground="White" FontSize="28" FontWeight="Bold" 
                                      HorizontalAlignment="Center" Margin="0,20,0,0"/>
                            
                            <!-- Time Remaining -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                <TextBlock x:Name="TimeRemaining" Text="3h 24m remaining" Foreground="LightGray" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Time slot section -->
                    <Grid Margin="0,40,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="TimeSlotBorder" Grid.Column="0" Background="#141720" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Time Slot" Foreground="LightGray" FontSize="12"/>
                                <TextBlock x:Name="TimeSlot" Text="5:00 AM - 9:00 AM" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Profile Description -->
                    <TextBlock x:Name="ProfileDescription" 
                               Text="Deep focus work during quiet morning hours when energy and concentration are at their peak. Perfect for complex problem-solving and creative tasks." 
                               Foreground="LightGray" FontSize="14" TextWrapping="Wrap" Margin="0,30,0,0"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Section Grid - Tasks -->
        <Border Grid.Column="1" Background="#141720" CornerRadius="20,20,20,20" Margin="-1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="40">
                    <TextBlock Text="Tasks" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>
                    
                    <!-- Tasks will be populated dynamically -->
                    <StackPanel x:Name="TasksPanel">
                        <!-- Tasks will be added here dynamically -->
                    </StackPanel>
                    
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
