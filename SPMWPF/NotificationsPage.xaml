<UserControl x:Class="SPMWPF.NotificationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">
    <!-- Only content, no background or border at root -->
    <Grid IsHitTestVisible="True" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="577*"/>
            <ColumnDefinition Width="397*"/>
        </Grid.ColumnDefinitions>

        <!-- Main Section Grid -->
        <Border Grid.Column="0" Background="#0e121a" CornerRadius="20,20,20,20" Margin="0,0,-1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40">

                    <!-- Page Title -->
                    <TextBlock Text="Tasks" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

                    <!-- Task List Panel -->
                    <StackPanel x:Name="TaskListPanel">
                        <!-- Tasks will be populated dynamically -->
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Section Grid - Currently Empty -->
        <Border Grid.Column="1" Background="#141720" CornerRadius="20,20,20,20" Margin="-1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="40">
                    <TextBlock Text="Task Summary" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>
                    
                    <!-- Summary content can be added here later -->
                    <TextBlock Text="Task overview and statistics will be displayed here." 
                               Foreground="LightGray" FontSize="14" TextWrapping="Wrap"/>
                    
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
