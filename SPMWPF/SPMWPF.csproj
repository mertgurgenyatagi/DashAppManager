<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    
    <!-- Application Properties -->
  <AssemblyTitle>Solo Project Manager</AssemblyTitle>
  <Product>Solo Project Manager</Product>
  <Company>SPM</Company>
  <Copyright>© 2025 SPM. All rights reserved.</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    
    <!-- Performance optimizations -->
    <PublishTrimmed>false</PublishTrimmed>
    <TieredCompilation>true</TieredCompilation>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    
    <!-- Additional animation performance settings -->
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  <ApplicationIcon>assets/images/spm_logo.ico</ApplicationIcon>
  </PropertyGroup>


    <ItemGroup>
      <!-- Images -->
  <Resource Include="assets/images/spm_logo.png" />
      
