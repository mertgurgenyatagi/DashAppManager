<UserControl x:Class="SPMWPF.Views.Pages.UserPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             IsHitTestVisible="False">
    <!-- Only content, no background or border at root -->
    <Grid IsHitTestVisible="True" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="577*"/>
                <ColumnDefinition Width="397*"/>
            </Grid.ColumnDefinitions>

            <!-- Middle Section Grid -->
            <Border Grid.Column="0" Background="#0e121a" CornerRadius="20,20,20,20" Margin="0,0,-1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40">

                        <!-- My Profile Title -->
                        <TextBlock Text="My Profile" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

                        <!-- Profile Card - Enlarged -->
                        <Border Background="#141720" Padding="40" Height="300">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Profile Picture - Centered -->
                                <Ellipse Width="120" Height="120" Fill="Gray" HorizontalAlignment="Center"/>
                                
                                <!-- User Name - Centered -->
                                <TextBlock Text="Temitope Aiyegbusi" Foreground="White" FontSize="28" FontWeight="SemiBold" 
                                          HorizontalAlignment="Center" Margin="0,20,0,0"/>
                                
                                <!-- User Info - Below picture -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                    <Ellipse Width="8" Height="8" Fill="Orange" VerticalAlignment="Center"/>
                                    <TextBlock Text="Marketing Dpt" Foreground="LightGray" FontSize="16" Margin="8,0,0,0"/>
                                    <TextBlock Text="|" Foreground="LightGray" FontSize="16" Margin="15,0,15,0"/>
                                    <TextBlock Text="Product Designer" Foreground="LightGray" FontSize="16"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Line Manager and Department - Pushed down -->
                        <Grid Margin="0,40,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#141720" Padding="15" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Line Manager" Foreground="LightGray" FontSize="12"/>
                                    <TextBlock Text="Olawale Oguntayo" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#141720" Padding="15" Margin="10,0,0,0">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Department" Foreground="LightGray" FontSize="12"/>
                                        <TextBlock Text="Product Design" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text=">" Foreground="LightGray" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Lorem Ipsum Text -->
                        <TextBlock Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia." 
                                   Foreground="LightGray" FontSize="14" TextWrapping="Wrap" Margin="0,30,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Section Grid -->
            <Border Grid.Column="1" Background="#141720" CornerRadius="20,20,20,20" Margin="-1,0,0,0">
                <StackPanel Margin="20">
                    <TextBlock Text="My Activity" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <!-- Activity content will go here -->
                </StackPanel>
            </Border>
    </Grid>
</UserControl>
